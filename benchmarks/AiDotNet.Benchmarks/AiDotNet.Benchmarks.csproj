<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Not shipped. release-please packs and pushes src/AiDotNet.csproj ALONE, so this
         produced a package nothing publishes or consumes. A BenchmarkDotNet harness, not a library. -->
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AiDotNet.csproj" />
  </ItemGroup>

</Project>

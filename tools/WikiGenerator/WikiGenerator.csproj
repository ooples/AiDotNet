<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AiDotNet.Tools.WikiGenerator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!-- Pulls AiDotNet + deps into output so generated examples can be compile-checked
       in-process (only compiling examples are emitted), and so types resolve. -->
  <ItemGroup Condition="'$(PublishedAiDotNetVersion)' == ''">
    <ProjectReference Include="..\..\src\AiDotNet.csproj" />
  </ItemGroup>

  <!-- -p:PublishedAiDotNetVersion=<version> takes the library from nuget.org instead of this checkout.
       generate-wiki.sh uses it when src/AiDotNet.csproj does not build, so the website can still be
       built and deployed with the API reference of the latest release. -->
  <ItemGroup Condition="'$(PublishedAiDotNetVersion)' != ''">
    <PackageReference Include="AiDotNet" VersionOverride="$(PublishedAiDotNetVersion)" />
  </ItemGroup>

</Project>

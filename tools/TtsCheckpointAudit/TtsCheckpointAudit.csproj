<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Existing friend access permits auditing internal neural components without expanding the public API. -->
    <AssemblyName>AiDotNetTests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/AiDotNet.csproj" /></ItemGroup>
</Project>

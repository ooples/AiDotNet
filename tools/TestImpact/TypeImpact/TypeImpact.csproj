<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test-level impact selection from the compiled assemblies. See Program.cs. Deliberately
       outside the solution's Directory.Build.props surface: it must build in seconds on a runner
       that already has the test output, and it references nothing but the BCL. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The self-test fixture is compiled by Test-TypeImpact.ps1, never into the tool. -->
    <Compile Remove="SelfTest/**" />
    <None Remove="SelfTest/**" />
  </ItemGroup>

</Project>

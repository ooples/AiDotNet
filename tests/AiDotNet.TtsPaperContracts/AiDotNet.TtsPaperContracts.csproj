<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AiDotNetTests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Newtonsoft.Json" />
    <!-- AiDotNet references only the managed ONNX Runtime API. Without the native package no onnxruntime.dll is
         copied here, and Windows loads System32's older WinML build (1.17), which rejects API version 31. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Xunit.SkippableFact" />
    <ProjectReference Include="../../src/AiDotNet.csproj" />
    <ProjectReference Include="../../src/AiDotNet.CodeAnalysis.TreeSitter/AiDotNet.CodeAnalysis.TreeSitter.csproj" />
    <Compile Include="../AiDotNet.Tests/GlobalUsings.cs" Link="GlobalUsings.cs" />
    <Compile Include="../AiDotNet.Tests/ModuleInitializer.cs" Link="ModuleInitializer.cs" />
    <Compile Include="../AiDotNet.Tests/Helpers/LicenseTestSupport.cs" Link="LicenseTestSupport.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/CosyVoice*Tests.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/CosyVoice3Fixture.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/VallEXCloneFixture.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/S3TokenizerReferenceTests.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/CamPlusPlusReferenceTests.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/WhisperTiktokenReferenceTests.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/VALLE*PaperTests.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/Valle2OptionFixture.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/VoiceCraftOptionFixture.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/NaturalSpeech3ModelTests.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/Mars5ModelTests.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/Mars5OptionFixture.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/XttsOptionFixture.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/XttsCodecOptionTests.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/PhemeOptionFixture.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/PhemePaperTests.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/GLM4VoiceTaskTests.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/GLM4VoiceFixture.cs" />
    <Compile Include="../AiDotNet.Tests/Audio/MusicGenPaperTests.cs" />
    <Compile Include="../AiDotNet.Tests/Audio/MusicGenReferenceTests.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/VallECoreParityTests.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/SPEARTTS*Tests.cs" />
    <Compile Include="../AiDotNet.Tests/TextToSpeech/E3TTSOptionsTests.cs" />
  </ItemGroup>
  <Import Project="AdversarialReview.projitems" />
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

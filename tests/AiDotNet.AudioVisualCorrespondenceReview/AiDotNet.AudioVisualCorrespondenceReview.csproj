<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;net471</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AssemblyName>AiDotNetTests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="../../src/AiDotNet.csproj" />
    <ProjectReference Include="../../src/AiDotNet.Generators/AiDotNet.Generators.csproj" Condition="'$(ReviewGeneratorAssemblyPath)' == ''" />
    <Reference Include="AiDotNet.Generators" Condition="'$(ReviewGeneratorAssemblyPath)' != ''">
      <HintPath>$(ReviewGeneratorAssemblyPath)</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../AiDotNet.Tests/GlobalUsings.cs" Link="GlobalUsings.cs" />
    <Compile Include="../AiDotNet.Tests/ModuleInitializer.cs" Link="ModuleInitializer.cs" />
    <Compile Include="../AiDotNet.Tests/Helpers/LicenseTestSupport.cs" Link="LicenseTestSupport.cs" />
    <Compile Include="../AiDotNet.Tests/Helpers/ReferenceIdentityComparer.cs" Link="ReferenceIdentityComparer.cs" />
    <Compile Include="../../src/AiDotNet.Generators/GeneratedVisionFixtureContract.cs" Link="GeneratedVisionFixtureContract.cs" />
    <Compile Include="../AiDotNet.Tests/UnitTests/NeuralNetworks/AudioVisualCorrespondenceExecutionTests.cs" Link="AudioVisualCorrespondenceExecutionTests.cs" />
    <Compile Include="../AiDotNet.Tests/UnitTests/NeuralNetworks/CustomObjectiveTrainingContractTests.cs" Link="CustomObjectiveTrainingContractTests.cs" />
    <Compile Include="../AiDotNet.Tests/Generators/ModelStateOwnershipContractTests.cs" Link="ModelStateOwnershipContractTests.cs" />
    <Compile Include="../AiDotNet.Tests/UnitTests/Models/ReadonlyNumericStateContractTests.cs" Link="ReadonlyNumericStateContractTests.cs" />
    <Compile Include="../AiDotNet.Tests/UnitTests/Models/ModelStateRegistryTests.cs" Link="ModelStateRegistryTests.cs" />
    <Compile Include="../AiDotNet.Tests/ModelFamilyTests/Base/NeuralNetworkModelTestBase.cs" Link="NeuralNetworkModelTestBase.cs" />
    <Compile Include="../AiDotNet.Tests/ModelFamilyTests/Base/ModelTestHelpers.cs" Link="ModelTestHelpers.cs" />
    <Compile Include="../AiDotNet.Tests/ModelFamilyTests/NeuralNetworks/AudioVisualCorrespondenceNetworkTests.cs" Link="AudioVisualCorrespondenceNetworkTests.cs" />
    <None Include="../AiDotNet.Tests/xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

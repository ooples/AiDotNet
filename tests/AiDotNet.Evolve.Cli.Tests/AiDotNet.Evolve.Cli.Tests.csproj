<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <ProjectReference Include="../../tools/AiDotNet.Evolve.Cli/AiDotNet.Evolve.Cli.csproj" />
    <ProjectReference Include="../../tools/AiDotNet.CSharp.Worker/AiDotNet.CSharp.Worker.csproj" />
    <Compile Include="../AiDotNet.Tests/IntegrationTests/Configuration/EvolveCommandLineTests.cs" Link="EvolveCommandLineTests.cs" />
    <None Include="../../tools/AiDotNet.CSharp.Worker/bin/$(Configuration)/$(TargetFramework)/AiDotNet.CSharp.Worker.runtimeconfig.json" Link="AiDotNet.CSharp.Worker.runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tools/AiDotNet.CSharp.Worker/bin/$(Configuration)/$(TargetFramework)/AiDotNet.CSharp.Worker.deps.json" Link="AiDotNet.CSharp.Worker.deps.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

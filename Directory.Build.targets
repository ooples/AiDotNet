<Project>
  <!-- Attribution receipts bind the exact commit independently. Avoid changing
       unchanged test-only dependency binaries solely because the commit changed.
       Normal builds and release/package builds retain their version/SourceLink
       provenance; this opt-in is restricted to the supported attribution TFM. -->
  <PropertyGroup Condition="'$(EnableTestAttribution)' == 'true' and '$(TargetFramework)' == 'net10.0'">
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceLink>false</EnableSourceLink>
    <SourceLink />
  </PropertyGroup>
</Project>

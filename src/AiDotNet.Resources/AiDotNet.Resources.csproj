<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Data-only assembly: the tokenizer vocabularies and text-to-speech front-end dictionaries the
      core AiDotNet package reads at run time. It is a separate, single-TFM package because the core
      package ships AiDotNet.dll once per target framework (five times), so every megabyte embedded
      there costs five in the .nupkg. 0.236.0 embedded 78 MB, which made the core package 554 MB and
      nuget.org rejected the push (413, limit 250 MB). netstandard2.0 is consumed by every core TFM,
      so the data ships once. Versioned and published in lockstep with the core package.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.204.0</Version>
    <Title>AiDotNet.Resources</Title>
    <Description>Embedded data for AiDotNet: tokenizer vocabularies and text-to-speech front-end dictionaries. A dependency of the AiDotNet package; not intended to be referenced directly. Licensed under BSL 1.1 - see https://aidotnet.dev/license.</Description>
    <Company>CrowdTrainer LLC</Company>
    <Authors>ooples</Authors>
    <Copyright>Copyright (C) 2024-2026 CrowdTrainer LLC</Copyright>
    <PackageProjectUrl>https://github.com/ooples/AiDotNet</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ooples/AiDotNet</RepositoryUrl>
    <PackageTags>ai; aidotnet; tokenizer; text-to-speech; resources</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <RootNamespace>AiDotNet.Resources</RootNamespace>
    <!-- One internal anchor type and no public API, so there is nothing to document. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AiDotNet" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="True" PackagePath="\" />
  </ItemGroup>


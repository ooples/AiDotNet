<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <RootNamespace>AiDotNet.Generators</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source generators must pin Roslyn version to match minimum supported VS/SDK -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <!--
      THE SHARED RANK RULE. Compiled into this assembly as well as into AiDotNet, so the
      layout-rank decision has exactly one implementation. The generator cannot reference
      the AiDotNet assembly (it runs inside the compiler, and referencing the project it
      analyses would be circular), and the rule has no Roslyn or reflection dependency, so
      sharing the source file is what removes the duplication rather than papering over it.
    -->
    <Compile Include="..\Attributes\TensorLayoutRank.cs" Link="Shared\TensorLayoutRank.cs" />
  </ItemGroup>

</Project>

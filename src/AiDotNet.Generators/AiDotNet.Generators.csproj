<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Not shipped. release-please packs and pushes src/AiDotNet.csproj ALONE, so this
         produced a package nothing publishes or consumes. A BUILD-TIME source generator, consumed by AiDotNet and the test project through
       ProjectReference OutputItemType="Analyzer". Its output is compiled INTO those
       assemblies. Consumers DO receive it, but through AiDotNet's own package: AiDotNet.csproj
       includes this project's built dll at analyzers/dotnet/cs/, which is how a PackageReference
       consumer gets the generated factories, and release-please fails the release if that entry
       is missing. A second standalone package would be an unreferenced duplicate. -->
    <IsPackable>false</IsPackable>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <RootNamespace>AiDotNet.Generators</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source generators must pin Roslyn version to match minimum supported VS/SDK -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>

	       metapackage in audit-2026-05 phase 2c (finding #14). Core code used it
	       only in NeuralProgramSynthesizer for precise SQL validation, which now
	       delegates to an optional ISqlSyntaxValidator (SqlSyntaxValidation.Validator)
	       and falls back to generic validation when none is registered. The
	       SQLite-backed validator ships in AiDotNet.Storage.Sqlite.
	  <PackageReference Include="Microsoft.Data.Sqlite" /> -->
	  <PackageReference Include="Microsoft.ML.OnnxRuntime" />
	  <!-- Microsoft.Research.SEALNet (homomorphic encryption) extracted to the
	       opt-in AiDotNet.Privacy.HE metapackage in audit-2026-05 phase 2c
	       (finding #14). SealHomomorphicEncryptionProvider moved there; the
	       IHomomorphicEncryptionProvider<T> interface + HomomorphicEncryptionProviderBase
	       stay in core. InMemoryFederatedTrainer no longer constructs SEAL by default —
	       it requires an IHomomorphicEncryptionProvider<T> to be supplied when HE is
	       enabled, and fails loudly otherwise. SEAL is no longer a core dependency.
	  <PackageReference Include="Microsoft.Research.SEALNet" /> -->
	  <PackageReference Include="Newtonsoft.Json" />
	  <!-- MatFileHandler — read .mat split/annotation files (SVHN, Stanford Cars, Flowers-102) -->
	  <PackageReference Include="MatFileHandler" />
	  <!-- Pinecone.Client removed in audit-2026-05 phase 2b: was declared but
	       no code in src/ ever referenced it. If we add a Pinecone-backed
	       IVectorStore implementation in future, it should ship in a
	       separate AiDotNet.Storage.Pinecone metapackage that ProjectReferences
	       the core AiDotNet assembly. Keep Pinecone.Client out of the core
	       package's transitive dependency surface. -->
	  <!-- SharpZipLib — bzip2 decompression for .tar.bz2 archives (LJSpeech) -->
	  <PackageReference Include="SharpZipLib" />
	  <!-- StackExchange.Redis lives only in the opt-in AiDotNet.Storage.Redis
	       metapackage; the core package must not pull it transitively. -->
	  <PackageReference Include="System.ValueTuple" />
	  <PackageReference Include="TreeSitter.DotNet" />
	  <PackageReference Include="FftSharp" />
	  <PackageReference Include="Parquet.Net" />
	  <!-- Explicit pin to override vulnerable transitive Snappier 1.3.0 (GHSA-pggp-6c3x-2xmx) -->
	  <PackageReference Include="Snappier" />
	  <PackageReference Include="YamlDotNet" />
	</ItemGroup>


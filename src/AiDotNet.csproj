	  <!-- The dynamic binder is part of the modern shared framework. Keeping this package on
	       net8/net10 makes current SDKs report NU1510 (and this project treats warnings as errors),
	       while net471 still needs the compatibility package. -->
	  <PackageReference Include="Microsoft.CSharp" Condition="'$(TargetFramework)' == 'net471' or '$(TargetFramework)' == 'net462' or '$(TargetFramework)' == 'netstandard2.0'" />
	  <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />

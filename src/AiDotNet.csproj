	<!-- Build-time key derivation resource (injected by CI/CD, not present in dev builds).
	     BuildKeyProvider uses this to derive encryption keys for AIMF model files.
	     Fork/dev builds without this key derive different keys and cannot decrypt official models.
	     See BuildKeyProvider.cs for the three-layer obfuscation system documentation. -->
	<ItemGroup>
	  <!-- Build key used by BuildKeyProvider to derive encryption keys for AIMF model file
	       protection. Injected during official CI/CD builds only. -->
	  <EmbeddedResource Include="BuildKey\BuildKey.bin" Condition="Exists('BuildKey\BuildKey.bin')">
	    <LogicalName>AiDotNet.BuildKey</LogicalName>
	  </EmbeddedResource>
	  <!-- Asymmetric license PUBLIC signing key(s) used by LicensePublicKeyProvider to verify
	       aidn2.{claims}.{signature} tokens offline (Ed25519 / EdDSA). Unlike BuildKey this is a
	       PUBLIC key and is safe to ship/extract (worthless to a forger). Injected during official
	       CI/CD builds; CI generates the Ed25519 keypair, keeps the PRIVATE key in a secret store
	       (never committed), and drops the public half here as JWK OKP JSON:
	       { "keys": [ { "kty":"OKP", "crv":"Ed25519", "kid":"...", "x":"<base64url 32-byte pubkey>" } ] }.
	       See LicensePublicKeyProvider.cs. -->
	  <EmbeddedResource Include="BuildKey\LicensePublicKey.json" Condition="Exists('BuildKey\LicensePublicKey.json')">
	    <LogicalName>AiDotNet.LicensePublicKey</LogicalName>
	  </EmbeddedResource>
	  <!-- Signed revocation deny-list (CRL) for aidn2 tokens, verified by LicenseRevocationProvider against
	       the embedded public key. Optional/additive: absent => nothing revoked (fail-open). Injected at
	       release (and refreshed) with the current signed CRL; also refetched at runtime on online validation. -->
	  <EmbeddedResource Include="BuildKey\LicenseRevocation.json" Condition="Exists('BuildKey\LicenseRevocation.json')">
	    <LogicalName>AiDotNet.LicenseRevocation</LogicalName>
	  </EmbeddedResource>
	  <EmbeddedResource Include="IntegrityHash\IntegrityHash.bin" Condition="Exists('IntegrityHash\IntegrityHash.bin')">
	    <LogicalName>AiDotNet.IntegrityHash</LogicalName>
	  </EmbeddedResource>
	</ItemGroup>


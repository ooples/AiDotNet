<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Opt-in SQLite metapackage (audit-2026-05 finding #14). Carries the
      Microsoft.Data.Sqlite dependency so the core AiDotNet package stays free
      of it. Provides a precise SQL syntax validator for the program synthesizer.
      Matches the core package's TFM set.
    -->
    <TargetFrameworks>net10.0;net8.0;net471</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>0.204.0</Version>
    <Title>AiDotNet.Storage.Sqlite</Title>
    <Description>SQLite-backed services for AiDotNet. Provides SqliteSqlSyntaxValidator (ISqlSyntaxValidator) for precise SQL validation in the program synthesizer. Opt-in: reference this package and register the validator via SqlSyntaxValidation.Validator. Licensed under BSL 1.1 — see https://aidotnet.dev/license.</Description>
    <Company>Ooples Finance</Company>
    <Authors>ooples</Authors>
    <Copyright>Ooples Finance LLC 2023</Copyright>
    <PackageProjectUrl>https://github.com/ooples/AiDotNet</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ooples/AiDotNet</RepositoryUrl>
    <PackageTags>ai; aidotnet; sqlite; sql; program-synthesis; storage</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AiDotNet.ProgramSynthesis.Validation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiDotNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="True" PackagePath="\" />
  </ItemGroup>
  <!--
    SQLitePCLRaw.lib.e_sqlite3 2.1.12 dropped the win-arm (ARM32) runtime: the package ships only
    win-arm64, win-x64 and win-x86. Its own buildTransitive/net461 targets were not updated to
    match and still declare runtimes\win-arm\native\e_sqlite3.dll as Content, so every .NET
    Framework build of this project fails with MSB3030 on a file the package does not contain.
    2.1.11 shipped that file; 2.1.12 does not. It arrives transitively as
    Microsoft.Data.Sqlite -> SQLitePCLRaw.bundle_e_sqlite3.

    Dropping the item rather than pinning back to 2.1.11 keeps the native SQLite binary current,
    and removes nothing that could ever be loaded here: the reference is to a 32-bit ARM build of
    .NET Framework, which this project does not target.

    Remove this once the upstream package declares only files it ships.
  -->
  <Target Name="DropMissingWinArmSqliteContent"
          AfterTargets="ResolvePackageAssets"
          Condition="'$(TargetFramework)' == 'net471'">
    <ItemGroup>
      <Content Remove="@(Content)"
               Condition="$([System.String]::Copy('%(Identity)').Contains('win-arm\native\e_sqlite3.dll'))" />
    </ItemGroup>
  </Target>

</Project>

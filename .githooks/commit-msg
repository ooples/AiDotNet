#!/bin/bash
#
# commit-msg hook — auto-fix the commit message to Conventional Commits BEFORE the
# commit is finalized, using the SAME shared fixer the CI uses
# (.github/scripts/commit-msg-autofix.py). Because the message is corrected at commit
# time, commits land already-compliant and the server-side commitlint auto-fixer never
# has to rewrite history / force-push the branch — which was overriding in-flight work
# and cancelling in-progress CI runs on active PRs.
#
# Fully automated (no manual message editing) and non-destructive (no force-push).
# Merge/revert/bot commits are passed through unchanged by the fixer itself.
#
# To enable this hook (once per clone/worktree), run from the repository root:
#   git config core.hooksPath .githooks
#
# If python3 is unavailable the hook no-ops; the commitlint.yml CI check still
# enforces compliance (it just won't auto-fix), so nothing silently slips through.

set -euo pipefail

msg_file="$1"
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"
script="$repo_root/.github/scripts/commit-msg-autofix.py"

if [ -f "$script" ] && command -v python3 >/dev/null 2>&1; then
    # The fixer reads the raw message on stdin and prints the corrected message.
    # It leaves already-compliant messages (and Merge/Revert/bot commits) unchanged.
    #
    # STDERR IS KEPT, NOT DISCARDED. Sending it to /dev/null meant a broken fixer
    # produced no signal at all: the developer saw a normal commit and never
    # learned the hook had stopped working.
    # A PRIVATE TEMP FILE, NOT A FIXED PATH. /tmp/commit-msg-autofix.err is
    # predictable and world-writable: two worktrees committing at once clobber each
    # other's stderr so the warning below reports the wrong error, and on a shared
    # host another user can pre-create the path as a symlink and have the
    # redirection write through it. mktemp gives a fresh 0600 file per invocation,
    # and the trap removes it on every exit path including the failure ones.
    # ERREXIT AGAIN, ON THE LINE THAT SETS UP THE GUARD. A bare assignment from a
    # command substitution takes the substitution's status, so a failing mktemp --
    # full disk, unwritable $TMPDIR, a noexec or quota mount -- killed the hook right
    # here and git rejected the commit, with no message, which is exactly the
    # no-op-on-failure contract the header promises. Same protection as the fixer
    # call below: run it in a compound list so errexit cannot fire, then fall back
    # to discarding stderr rather than to failing the commit.
    err_file=""
    err_file="$(mktemp "${TMPDIR:-/tmp}/commit-msg-autofix.XXXXXX" 2>/dev/null)" || err_file=""
    if [ -z "$err_file" ]; then
        err_file=/dev/null
        echo "commit-msg: could not create a temp file for the fixer's stderr; continuing without it." >&2
    else
        trap 'rm -f "$err_file"' EXIT
    fi

    # ERREXIT MUST NOT FIRE HERE. `set -e` is on, and a bare assignment from a
    # command substitution takes the substitution's exit status, so a fixer that
    # exits nonzero terminated the hook right here -- the pass-through branch below
    # never ran and git aborted the commit. A broken fixer blocked EVERY commit,
    # which is the opposite of the no-op-on-failure contract in the header. The
    # `|| status=$?` puts the assignment in a compound list, where errexit is
    # suppressed, so the status reaches the check below instead of killing the shell.
    status=0
    fixed="$(python3 "$script" < "$msg_file" 2>"$err_file")" || status=$?
    err="$(cat "$err_file" 2>/dev/null || true)"

    # EMPTY OUTPUT MUST NOT OVERWRITE THE MESSAGE. Accepting any exit-0 result
    # included an empty stdout, which wrote a lone newline into the message file.
    # Git then aborts with "Aborting commit due to empty commit message" and the
    # message the developer typed is GONE -- the exact destructive outcome the
    # header promises this hook does not have. A fixer that returns nothing is a
    # broken fixer, so the original message stands.
    if [ "$status" -eq 0 ] && [ -n "${fixed//[[:space:]]/}" ]; then
        printf '%s\n' "$fixed" > "$msg_file"
    else
        echo "commit-msg: autofix did not run; keeping your message as written." >&2
        if [ -n "$err" ]; then
            echo "commit-msg: $err" >&2
        fi
    fi
fi

exit 0

---
import AccountLayout from '../../../layouts/AccountLayout.astro';
const base = import.meta.env.BASE_URL;
const btn = 'px-4 py-2 text-sm font-semibold rounded-xl transition-opacity';
const row = 'w-full text-left flex items-center justify-between p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors disabled:opacity-60 disabled:cursor-wait';
---

<AccountLayout title="Billing - AiDotNet" description="Manage your AiDotNet subscription, view invoices, and update payment methods." activeTab="billing">
  <div id="billing-root" class="space-y-6" data-billing-loaded="false" data-tier="" data-billing-account="">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Billing</h1>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Manage your subscription and payment method</p>
    </div>

    <div id="billing-error" role="alert" class="hidden p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-sm text-red-600 dark:text-red-400"></div>
    <div id="billing-ownership-notice" role="status" class="hidden p-4 rounded-xl border text-sm">
      <p id="billing-ownership-message"></p>
      <a class="underline" href="/account/licenses/">Claim a completed checkout</a>
      <a class="underline ml-4" href="mailto:support@aidotnet.dev">Contact billing support</a>
    </div>

    <!-- Current plan -->
    <div class="gsap-fade-up bg-white dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-700 p-6">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h2 class="text-sm font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">Current Plan</h2>
          <div class="flex items-center gap-3">
            <span id="billing-plan" class="text-2xl font-bold text-slate-900 dark:text-white">Loading…</span>
            <span id="billing-badge" class="hidden inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold"></span>
          </div>
          <p id="billing-price" class="mt-1 text-sm text-slate-500 dark:text-slate-400"></p>
          <p id="billing-renewal" class="hidden mt-1 text-sm text-slate-500 dark:text-slate-400"></p>
        </div>
        <div id="billing-actions" class="flex flex-wrap gap-2">
          <a id="billing-change-plan" href={`${base}pricing/`} class={`${btn} text-white bg-gradient-brand hover:opacity-90`}>Upgrade</a>
          <button id="billing-cancel" type="button" class={`hidden ${btn} border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700`}>Cancel subscription</button>
        </div>
      </div>

      <p id="billing-no-account" class="hidden mt-4 p-3 rounded-xl bg-amber-500/10 text-sm text-amber-700 dark:text-amber-300">
        This plan was set up by the AiDotNet team rather than through online checkout, so there is no online billing account to manage.
        Email <a class="underline" href="mailto:support@aidotnet.dev">support@aidotnet.dev</a> to change or cancel it.
      </p>

      <div class="mt-6 pt-6 border-t border-slate-200 dark:border-slate-700">
        <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">Your plan includes:</h3>
        <ul id="plan-features" class="grid grid-cols-1 sm:grid-cols-2 gap-2"></ul>
      </div>
    </div>

    <!-- Stripe Customer Portal -->
    <div id="portal-section" class="hidden gsap-fade-up bg-white dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-700 p-6">
      <h2 class="text-sm font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-4">Payment & Invoices</h2>
      <div class="space-y-4">
        <button id="manage-subscription-btn" type="button" class={row}>
          <span class="flex items-center gap-3">
            <svg class="w-5 h-5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" />
            </svg>
            <span>
              <span class="block text-sm font-medium text-slate-900 dark:text-white">Manage Subscription</span>
              <span class="block text-xs text-slate-500 dark:text-slate-400">Update payment method, billing details, seats</span>
            </span>
          </span>
          <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </button>

        <button id="view-invoices-btn" type="button" class={row}>
          <span class="flex items-center gap-3">
            <svg class="w-5 h-5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
            <span>
              <span class="block text-sm font-medium text-slate-900 dark:text-white">View Invoices</span>
              <span class="block text-xs text-slate-500 dark:text-slate-400">Download past invoices and receipts</span>
            </span>
          </span>
          <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </button>
      </div>
    </div>

    <p id="later-cancellation-help" class="hidden text-sm text-slate-500">Stripe will show the current schedule. Resume the subscription there if needed, then cancel at the end of the billing period.</p>
    <div id="other-billing-accounts" class="hidden flex flex-wrap gap-3"></div>

    <!-- FAQ -->
    <div class="gsap-fade-up bg-white dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-700 p-6">
      <h2 class="text-sm font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-4">Frequently Asked</h2>
      <div class="space-y-4">
        <details class="group">
          <summary class="flex items-center justify-between cursor-pointer text-sm font-medium text-slate-700 dark:text-slate-300">
            How do I cancel my subscription?
            <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
            Click "Cancel subscription" above. Stripe confirms the cancellation, and nothing more is charged. Your access will continue until the end of the current billing period.
          </p>
        </details>
        <details class="group">
          <summary class="flex items-center justify-between cursor-pointer text-sm font-medium text-slate-700 dark:text-slate-300">
            Can I switch between monthly and yearly?
            <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
            Yes. Yes. Click "Change plan" above and pick the other billing period; Stripe prorates the difference. Annual plans save you about 17% compared to monthly.
          </p>
        </details>
        <details class="group">
          <summary class="flex items-center justify-between cursor-pointer text-sm font-medium text-slate-700 dark:text-slate-300">
            Is the open-source library really free?
            <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
            Training and inference are always free and do not require a license key. AiDotNet is licensed under BSL 1.1, which converts to Apache 2.0 after 3 years. Model save/load operations require a license key after the 30-day free trial (10 save/load operations). Community licenses are free for individuals and companies with less than $1M annual revenue.
          </p>
        </details>
      </div>
    </div>
  </div>

  <script>
    import { loadBillingState, openPortal, cancelBeforeRenewal, formatMoney, formatDate, cancellationDate, TIER_LABEL, type PlanTier, type PortalAction, type SubscriptionSummary } from '../../../lib/billing';

    const FEATURES: Record<PlanTier, string[]> = {
      free: ['Training and inference (always free)', 'All 8,100+ public classes', 'GPU acceleration (any vendor)', 'Model save/load with a free Community license key'],
      pro: ['Commercial use authorized', '5 machine activations per seat', 'Model encryption (AES-256-GCM)', 'Priority GitHub issues and direct email support', 'API key management', 'Production deployments'],
      enterprise: ['Everything in Professional', '10 machine activations per seat', 'Offline license validation', 'Air-gapped deployment support', 'Dedicated support engineer + custom SLA', 'Architecture review and consulting'],
    };
    const LIST_PRICE: Record<PlanTier, string> = { free: '$0/month', pro: '$29/month per seat', enterprise: '$99/month per seat' };

    const $ = (id: string) => document.getElementById(id);
    const root = $('billing-root')!;
    let laterCancellation: { subscriptionId: string; scheduled: number; renewal: number } | null = null;
    let lastSubscription: SubscriptionSummary | null = null;

    function showError(message: string) {
      const el = $('billing-error')!;
      el.textContent = message;
      el.classList.remove('hidden');
      el.scrollIntoView({ block: 'nearest' });
    }

    // Every portal control: disable while the request is in flight, surface any failure.
    function wirePortal(id: string, req: PortalAction) {
      const el = $(id) as HTMLButtonElement | null;
      el?.addEventListener('click', async () => {
        $('billing-error')!.classList.add('hidden');
        if (id === 'billing-cancel' && laterCancellation) {
          const approved = { ...laterCancellation };
          if (!window.confirm(`Your subscription is scheduled to end on ${formatDate(approved.scheduled)}. End it on ${formatDate(approved.renewal)} instead, before another renewal? Review the current schedule and confirm in Stripe.`)) return;
          el.disabled = true;
          let refreshed = false;
          try {
            const err = await cancelBeforeRenewal(laterCancellation.subscriptionId, laterCancellation.renewal, laterCancellation.scheduled);
            if (!err) return; // Stripe owns the final confirmation and mutation.
            refreshed = await loadBilling();
            if (!refreshed) showError('Could not refresh your billing details. Reload the page before confirming another cancellation.');
            else if (lastSubscription?.id === approved.subscriptionId && cancellationDate(lastSubscription) === approved.renewal) $('billing-error')!.classList.add('hidden');
            else showError(err);
          } catch {
            laterCancellation = null;
            showError('Could not refresh your billing details. Reload the page before confirming another cancellation.');
          } finally { el.disabled = !refreshed; }
          return;
        }
        el.disabled = true;
        const err = await openPortal(req, '/account/billing/');
        if (err && req.action === 'cancel') {
          let refreshed = false;
          try { refreshed = await loadBilling(); showError(refreshed ? err : 'Could not refresh your billing details. Reload the page before confirming another cancellation.'); }
          catch { laterCancellation = null; showError('Could not refresh your billing details. Reload the page before confirming another cancellation.'); }
          finally { el.disabled = !refreshed; }
        } else if (err) { el.disabled = false; showError(err); }
      });
    }

    function badge(text: string, tone: 'ok' | 'warn' | 'bad') {
      const el = $('billing-badge')!;
      const tones = {
        ok: 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400',
        warn: 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400',
        bad: 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400',
      };
      el.textContent = text;
      el.className = `inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${tones[tone]}`;
    }

    async function loadBilling() {
      laterCancellation = null;
      lastSubscription = null;
      const state = await loadBillingState();
      if (!state.signedIn) { root.setAttribute('data-billing-loaded', 'true'); return false; }
      // What follows is then only the profile's view; say so rather than show it as the whole truth.
      if (state.error) showError(state.error);
      $('billing-ownership-message')!.textContent = state.ownershipMessage ?? '';
      $('billing-ownership-notice')!.classList.toggle('hidden', !state.ownershipMessage);

      const sub = state.subscription;
      lastSubscription = sub;
      // The live Stripe subscription wins over the profile mirror when they disagree.
      const tier: PlanTier = sub?.tier ?? state.tier;
      const paid = tier !== 'free';
      root.dataset.tier = tier;
      root.dataset.billingAccount = String(state.hasBillingAccount);

      $('billing-plan')!.textContent = TIER_LABEL[tier];
      const status = sub?.status ?? state.status;
      const cancellationAt = cancellationDate(sub);
      laterCancellation = sub && cancellationAt != null && cancellationAt > sub.current_period_end
        ? { subscriptionId: sub.id, scheduled: cancellationAt, renewal: sub.current_period_end } : null;
      $('later-cancellation-help')!.classList.toggle('hidden', !laterCancellation);
      const otherAccounts = $('other-billing-accounts')!;
      otherAccounts.replaceChildren();
      for (const [index, account] of (state.billingAccounts ?? []).filter(account => !account.selected).entries()) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'px-4 py-2 rounded-lg border text-sm';
        button.textContent = `Manage additional billing account ${index + 1}`;
        button.addEventListener('click', async () => {
          button.disabled = true;
          const err = await openPortal({ action: 'manage', customer_id: account.id }, '/account/billing/');
          if (err) { button.disabled = false; showError(err); }
        });
        otherAccounts.append(button);
      }
      otherAccounts.classList.toggle('hidden', !otherAccounts.childElementCount);
      if (cancellationAt) badge(cancellationAt === sub?.current_period_end ? 'Cancels at period end' : 'Cancellation scheduled', 'warn');
      else if (status === 'active') badge('Active', 'ok');
      else if (status === 'trialing') badge('Trial', 'ok');
      else badge(status.replace(/_/g, ' '), status === 'past_due' || status === 'suspended' ? 'bad' : 'warn');

      $('billing-price')!.textContent = sub?.unit_amount != null
        ? `${formatMoney(sub.unit_amount * (sub.quantity || 1), sub.currency)}/${sub.interval}${sub.quantity > 1 ? ` (${sub.quantity} seats)` : ''}`
        : LIST_PRICE[tier];

      if (sub) {
        const renewal = $('billing-renewal')!;
        renewal.textContent = cancellationAt
          ? `Your access ends on ${formatDate(cancellationAt)}.`
          : sub.status === 'trialing' && sub.trial_end
            ? `Trial ends on ${formatDate(sub.trial_end)}.`
            : `Renews on ${formatDate(sub.current_period_end)}.`;
        renewal.classList.remove('hidden');
      }

      const list = $('plan-features')!;
      list.replaceChildren(...FEATURES[tier].map((f) => {
        const li = document.createElement('li');
        li.className = 'flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400';
        li.innerHTML = '<svg class="w-4 h-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>';
        li.append(f);
        return li;
      }));

      const change = $('billing-change-plan')!;
      change.textContent = paid ? 'Change plan' : 'Upgrade';

      $('portal-section')!.classList.toggle('hidden', !state.hasBillingAccount);
      $('billing-no-account')!.classList.toggle('hidden', state.hasBillingAccount || !paid || !!state.ownershipMessage);
      $('billing-cancel')!.classList.toggle('hidden', !state.hasBillingAccount || !sub || (!!cancellationAt && !laterCancellation));
      $('billing-cancel')!.textContent = laterCancellation ? 'Review cancellation in Stripe' : 'Cancel subscription';

      root.setAttribute('data-billing-loaded', 'true');
      return !state.error;
    }

    wirePortal('manage-subscription-btn', { action: 'manage' });
    wirePortal('view-invoices-btn', { action: 'manage' });
    wirePortal('billing-cancel', { action: 'cancel' });
    loadBilling().catch((e) => {
      showError('Could not load your billing details. Please refresh the page.');
      console.error(e);
      root.setAttribute('data-billing-loaded', 'true');
    });
  </script>
</AccountLayout>

---
import AccountLayout from '../../../layouts/AccountLayout.astro';
const base = import.meta.env.BASE_URL;
---

<AccountLayout title="Settings - AiDotNet" description="Manage your AiDotNet account settings, profile information, and security." activeTab="settings">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Settings</h1>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Manage your profile and account security</p>
    </div>

    <!-- Profile section -->
    <div class="gsap-fade-up bg-white dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-700 p-6">
      <h2 class="text-sm font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-4">Profile</h2>
      <form id="profile-form" class="space-y-4">
        <div class="flex items-center gap-4 mb-6">
          <div id="avatar-container" class="w-16 h-16 rounded-full bg-gradient-to-r from-brand-blue to-brand-purple flex items-center justify-center text-white text-xl font-bold">
            ?
          </div>
          <div>
            <p id="profile-email" class="text-sm font-medium text-slate-900 dark:text-white">Loading...</p>
            <p id="profile-provider" class="text-xs text-slate-500 dark:text-slate-400">Loading...</p>
          </div>
        </div>

        <div>
          <label for="full-name" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">
            Full Name
          </label>
          <input
            type="text"
            id="full-name"
            class="w-full px-4 py-3 text-sm bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-brand-blue/50 focus:border-brand-blue outline-none transition-all text-slate-900 dark:text-white"
            placeholder="Your name"
          />
        </div>

        <div id="profile-success" class="hidden p-3 text-sm text-green-600 dark:text-green-400 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-xl"></div>
        <div id="profile-error" class="hidden p-3 text-sm text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl"></div>

        <button
          type="submit"
          class="px-6 py-2.5 text-sm font-semibold text-white rounded-xl bg-gradient-brand hover:opacity-90 transition-opacity"
        >
          Save Changes
        </button>
      </form>
    </div>

    <!-- Password section (only for email/password users) -->
    <div id="password-section" class="hidden gsap-fade-up bg-white dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-700 p-6">
      <h2 class="text-sm font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-4">Change Password</h2>
      <form id="password-form" class="space-y-4">
        <div>
          <label for="new-password" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">
            New Password
          </label>
          <input
            type="password"
            id="new-password"
            minlength="8"
            required
            class="w-full px-4 py-3 text-sm bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-brand-blue/50 focus:border-brand-blue outline-none transition-all text-slate-900 dark:text-white"
            placeholder="Minimum 8 characters"
          />
        </div>

        <div>
          <label for="confirm-password" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">
            Confirm New Password
          </label>
          <input
            type="password"
            id="confirm-password"
            minlength="8"
            required
            class="w-full px-4 py-3 text-sm bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-brand-blue/50 focus:border-brand-blue outline-none transition-all text-slate-900 dark:text-white"
            placeholder="Confirm your new password"
          />
        </div>

        <div id="password-success" class="hidden p-3 text-sm text-green-600 dark:text-green-400 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-xl"></div>
        <div id="password-error" class="hidden p-3 text-sm text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl"></div>

        <button
          type="submit"
          class="px-6 py-2.5 text-sm font-semibold text-white rounded-xl bg-gradient-brand hover:opacity-90 transition-opacity"
        >
          Update Password
        </button>
      </form>
    </div>

    <!-- Danger zone -->
    <div class="gsap-fade-up bg-white dark:bg-slate-800/50 rounded-2xl border border-red-200 dark:border-red-800/50 p-6">
      <h2 class="text-sm font-medium text-red-500 uppercase tracking-wider mb-4">Danger Zone</h2>
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-slate-900 dark:text-white">Delete Account</p>
          <p class="text-xs text-slate-500 dark:text-slate-400">Permanently delete your account and all associated data.</p>
        </div>
        <button
          id="delete-account-btn"
          class="px-4 py-2 text-sm font-medium text-red-600 dark:text-red-400 border border-red-200 dark:border-red-800 rounded-xl hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors"
        >
          Delete Account
        </button>
      </div>
    </div>
  </div>

  <!-- A native modal dialog: the browser keeps focus inside it, makes the page behind inert and closes it on Escape. -->
  <dialog id="delete-account-modal" class="w-full max-w-md p-0 bg-transparent backdrop:bg-black/50" aria-labelledby="delete-account-title">
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6">
      <h2 id="delete-account-title" class="text-lg font-semibold text-slate-900 dark:text-white">Delete your account?</h2>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
        This permanently deletes your profile, API keys and usage history, and revokes every license key on the account,
        including on machines already activated. It cannot be undone.
      </p>
      <label for="delete-confirm-input" class="block mt-4 text-sm font-medium text-slate-700 dark:text-slate-300">Type <strong>DELETE</strong> to confirm</label>
      <input id="delete-confirm-input" type="text" autocomplete="off" class="mt-1 w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 text-slate-900 dark:text-white" />
      <p id="delete-account-error" role="alert" class="hidden mt-3 text-sm text-red-600 dark:text-red-400"></p>
      <div class="mt-6 flex gap-3">
        <button id="delete-cancel-btn" type="button" class="flex-1 px-4 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-300 border border-slate-300 dark:border-slate-600 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-700">Cancel</button>
        <button id="delete-confirm-btn" type="button" disabled class="flex-1 px-4 py-2.5 text-sm font-semibold text-white rounded-xl bg-red-600 hover:bg-red-700 disabled:opacity-50 disabled:cursor-not-allowed">Delete account</button>
      </div>
    </div>
  </dialog>

  <script>
    import { supabase } from '../../../lib/supabase';

    async function loadSettings() {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) return;

      // Set profile info
      const emailEl = document.getElementById('profile-email');
      const providerEl = document.getElementById('profile-provider');
      const nameInput = document.getElementById('full-name') as HTMLInputElement;
      const avatarEl = document.getElementById('avatar-container');

      if (emailEl) emailEl.textContent = user.email || '';

      const provider = user.app_metadata?.provider || 'email';
      if (providerEl) providerEl.textContent = `Signed in with ${provider}`;

      if (nameInput && user.user_metadata?.full_name) {
        nameInput.value = user.user_metadata.full_name;
      }

      // Avatar
      if (avatarEl) {
        if (user.user_metadata?.avatar_url) {
          avatarEl.innerHTML = `<img src="${user.user_metadata.avatar_url}" alt="Avatar" class="w-16 h-16 rounded-full object-cover" />`;
        } else {
          const initial = (user.user_metadata?.full_name || user.email || '?')[0].toUpperCase();
          avatarEl.textContent = initial;
        }
      }

      // Show password section only for email users
      if (provider === 'email') {
        const passwordSection = document.getElementById('password-section');
        if (passwordSection) passwordSection.classList.remove('hidden');
      }
    }

    // Profile form
    const profileForm = document.getElementById('profile-form') as HTMLFormElement;
    if (profileForm) {
      profileForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fullName = (document.getElementById('full-name') as HTMLInputElement).value;

        const { error } = await supabase.auth.updateUser({
          data: { full_name: fullName },
        });

        const successEl = document.getElementById('profile-success');
        const errorEl = document.getElementById('profile-error');

        if (error) {
          if (errorEl) { errorEl.textContent = error.message; errorEl.classList.remove('hidden'); }
          if (successEl) successEl.classList.add('hidden');
        } else {
          if (successEl) { successEl.textContent = 'Profile updated successfully.'; successEl.classList.remove('hidden'); }
          if (errorEl) errorEl.classList.add('hidden');

          // Also update profile table
          const { data: { user } } = await supabase.auth.getUser();
          if (user) {
            await supabase
              .from('profiles')
              .update({ full_name: fullName, updated_at: new Date().toISOString() })
              .eq('id', user.id);
          }
        }
      });
    }

    // Password form
    const passwordForm = document.getElementById('password-form') as HTMLFormElement;
    if (passwordForm) {
      passwordForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const newPassword = (document.getElementById('new-password') as HTMLInputElement).value;
        const confirmPassword = (document.getElementById('confirm-password') as HTMLInputElement).value;

        const successEl = document.getElementById('password-success');
        const errorEl = document.getElementById('password-error');

        if (newPassword !== confirmPassword) {
          if (errorEl) { errorEl.textContent = 'Passwords do not match.'; errorEl.classList.remove('hidden'); }
          if (successEl) successEl.classList.add('hidden');
          return;
        }

        const { error } = await supabase.auth.updateUser({ password: newPassword });

        if (error) {
          if (errorEl) { errorEl.textContent = error.message; errorEl.classList.remove('hidden'); }
          if (successEl) successEl.classList.add('hidden');
        } else {
          if (successEl) { successEl.textContent = 'Password updated successfully.'; successEl.classList.remove('hidden'); }
          if (errorEl) errorEl.classList.add('hidden');
          passwordForm.reset();
        }
      });
    }

    // Delete account
    const deleteModal = document.getElementById('delete-account-modal') as HTMLDialogElement;
    const deleteInput = document.getElementById('delete-confirm-input') as HTMLInputElement;
    const deleteConfirm = document.getElementById('delete-confirm-btn') as HTMLButtonElement;
    const deleteError = document.getElementById('delete-account-error')!;
    const deleteOpener = document.getElementById('delete-account-btn');
    // Each opening is a new generation; a response for an earlier one must not touch this one.
    let deleteGeneration = 0;
    let deletePending = false;
    const syncConfirm = () => {
      deleteConfirm.disabled = deletePending || deleteInput.value.trim() !== 'DELETE';
      deleteConfirm.textContent = deletePending ? 'Deleting…' : 'Delete account';
    };
    const closeDelete = () => { if (deleteModal.open) deleteModal.close(); };
    // close() and Escape both end here: reset the form and give focus back to the opener.
    deleteModal.addEventListener('close', () => {
      deleteGeneration++;
      deletePending = false;
      deleteInput.value = '';
      deleteError.classList.add('hidden');
      syncConfirm();
      deleteOpener?.focus();
    });
    deleteOpener?.addEventListener('click', () => {
      deleteModal.showModal();
      deleteInput.focus();
    });
    document.getElementById('delete-cancel-btn')?.addEventListener('click', closeDelete);
    deleteInput.addEventListener('input', syncConfirm);
    deleteConfirm.addEventListener('click', async () => {
      if (deletePending || deleteInput.value.trim() !== 'DELETE') return;
      const generation = deleteGeneration;
      deletePending = true;
      syncConfirm();
      deleteError.classList.add('hidden');
      const { error } = await supabase.functions.invoke('delete-account', { method: 'POST', body: { confirm: 'DELETE' } });
      if (error) {
        // The dialog was closed (and maybe reopened) meanwhile: this answer belongs to a dialog that is gone.
        if (generation !== deleteGeneration) return;
        let message = 'Your account could not be deleted. Please try again or email support@aidotnet.dev.';
        try {
          const payload = await (error as { context?: Response }).context?.json();
          if (payload?.message) message = payload.message;
        } catch { /* keep the generic message */ }
        deleteError.textContent = message;
        deleteError.classList.remove('hidden');
        deletePending = false;
        syncConfirm();
        return;
      }
      // Deleted, even if the dialog was closed while waiting: the account is gone either way.
      await supabase.auth.signOut({ scope: 'local' });
      window.location.assign('/?account_deleted=1');
    });

    loadSettings();
  </script>
</AccountLayout>
